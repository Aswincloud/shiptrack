# Blue Dart tracking uses no credentials — the carrier scrapes the public
# tracking page at bluedart.com/trackdartresultthirdparty. The commercial
# tracking API requires customer credentials from a Blue Dart RM and is
# not available through the DHL Developer Portal.

# Alerts / notifications (owner-only, public signup arrives later)
# Bearer token required to create watches via POST /api/watches.
#   Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Random secret used to sign unsubscribe tokens in alert emails.
#   Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Resend API (https://resend.com). RESEND_FROM must be a verified sender.
RESEND_API_KEY=
RESEND_FROM=ShipTrack <alerts@yourdomain.com>

# Public URL of the deployed app — used to build links in emails.
APP_URL=https://shiptrack.example.com

# --- WhatsApp alerts (optional) ---------------------------------------------
# Opt-in WhatsApp messages on shipment milestones (picked up, out for delivery,
# delivered, exception, returned) via Meta's WhatsApp Cloud API. Leave all of
# these unset to hide the feature. Full setup: README → "WhatsApp alerts".
#
# From Meta App Dashboard → WhatsApp → API Setup:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The business number itself, E.164 digits with no "+" (users message it to link):
WHATSAPP_BUSINESS_NUMBER=
# Approved *utility* template for alerts and its language code (must match exactly):
WHATSAPP_TEMPLATE_NAME=tracking_update
WHATSAPP_TEMPLATE_LANG=en
# Inbound webhook (linking, STOP/START, replies). App Dashboard → App settings → Basic:
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into the webhook config in the App Dashboard:
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
