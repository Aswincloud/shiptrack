# Blue Dart API credentials (request from Blue Dart B2B team)
# Reference: https://apigateway.bluedart.com/
BLUEDART_LICENSE_KEY=
BLUEDART_LOGIN_ID=
BLUEDART_API_KEY=
# Set to "prod" to use the live endpoint, "staging" otherwise
BLUEDART_ENV=staging

# Alerts / notifications (owner-only, public signup arrives later)
# Bearer token required to create watches via POST /api/watches.
#   Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Random secret used to sign unsubscribe tokens in alert emails.
#   Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Resend API (https://resend.com). RESEND_FROM must be a verified sender.
RESEND_API_KEY=
RESEND_FROM=ShipTrack <alerts@yourdomain.com>

# Public URL of the deployed app — used to build links in emails.
APP_URL=https://shiptrack.example.com
