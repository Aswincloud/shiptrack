# Blue Dart API credentials.
# Get these from the DHL API Developer Portal: https://developer.dhl.com
#   1. My Apps > Add Developer App
#   2. Subscribe to "Shipment Tracking (DHL eCommerce India, Blue Dart)"
#   3. App page > Credentials > "API Key" and "API Secret"
# Note: New apps take ~24h after creation before auth calls succeed.
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
# "prod" hits apigateway.bluedart.com, "staging" hits apigateway-sandbox.bluedart.com
BLUEDART_ENV=prod

# Alerts / notifications (owner-only, public signup arrives later)
# Bearer token required to create watches via POST /api/watches.
#   Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Random secret used to sign unsubscribe tokens in alert emails.
#   Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Resend API (https://resend.com). RESEND_FROM must be a verified sender.
RESEND_API_KEY=
RESEND_FROM=ShipTrack <alerts@yourdomain.com>

# Public URL of the deployed app — used to build links in emails.
APP_URL=https://shiptrack.example.com
