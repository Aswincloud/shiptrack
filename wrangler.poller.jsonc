{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiptrack-poller",
  "main": "workers/poller/index.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiptrack",
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ]
}
